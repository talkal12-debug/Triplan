חליסקו, מקסיקו. הכוונה לבנות את המקדש הוכרזה ב-14 באפריל 1999 במכתב של הנשיאות הראשונה למנהיגי הכהונה המקומיים.", "mx-guadalajara-zoologico-guadalajara-138277734": "גן החיות של גוודלחרה הוא הגן הזואולוגי הראשי בעיר גוודלחרה שבמדינת חליסקו במקסיקו, והוא נחשב לאחד החשובים באמריקה הלטינית. זהו גן החיות הגדול במדינה מבחינת מספר המינים.", "mx-guadalajara-mercado-libertad-san-juan-de-dios-11654088": "מרקדו ליברטד, המוכר יותר כמרקדו סן חואן דה דיוס, שוכן בעיר גוודלחרה שבחליסקו, מקסיקו. זהו השוק המקורה הגדול ביותר באמריקה הלטינית, בשטח של 40,000 מ\"ר.", "mx-guadalajara-rotonda-de-los-ilustres-jalisiences-562057473": "רוטונדת בני חליסקו המהוללים היא ציון דרך ברובע סנטרו בגוודלחרה, במדינת חליסקו שבמקסיקו.", "mx-guadalajara-plaza-rotonda-de-los-jalisciences-ilustr-15777069": "רוטונדת בני חליסקו המהוללים היא ציון דרך ברובע סנטרו בגוודלחרה, במדינת חליסקו שבמקסיקו.", "mx-guadalajara-acuario-michin-485610865": "אקווריום מיצ'ין גוודלחרה הוא אקווריום בגוודלחרה, במדינת חליסקו שבמקסיקו.", "mx-guadalajara-museo-regional-de-guadalajara-2607681": "מוזיאון בחליסקו, מקסיקו", "mx-guadalajara-museo-de-las-artes-populares-de-jalisco-9750319317": "מוזיאון בחליסקו, מקסיקו", "mx-guadalajara-museo-de-arte-de-zapopan-932258477": "מוזיאון לאמנות בסאפופן, חליסקו, מקסיקו", "mx-guadalajara-museo-de-la-ciudad-4508993089": "מוזיאון בחליסקו, מקסיקו", "mx-guadalajara-japi-jalisco-paseo-interactivo-1414802015": "מוזיאון בסאפופן, חליסקו, מקסיקו", "mx-guadalajara-museo-del-periodismo-y-artes-graficas-4408820788": "מוזיאון בחליסקו, מקסיקו", "mx-guadalajara-museo-de-cera-guadalajara-4738630914": "מוזיאון בחליסקו, מקסיקו", "mx-guadalajara-casa-museo-lopez-portillo-8401064217": "מוזיאון בחליסקו, מקסיקו", "mx-merida-catedral-de-san-ildefonso-31296521": "קתדרלת מרידה, במרידה שבמדינת יוקטן במקסיקו, היא אחת הקתדרלות העתיקות ביותר ביבשת אמריקה.", "mx-merida-gran-museo-del-mundo-maya-533677673": "מוזיאון המוקדש לתרבות המאיה במרידה, מקסיקו", "mx-merida-museo-de-la-cancion-yucateca-584989441": "מוזיאון השיר היוקטקי הוא מוזיאון בעיר מרידה שבמדינת יוקטן, מקסיקו. הוא נוסד ב-1978, ומטרתו להציל, לשמר ולקדם את המוזיקה האופיינית ואת הרקע התרבותי של חצי האי יוקטן.", "mx-merida-gran-parque-la-pancha-1225740845": "פארק ציבורי במרידה, מקסיקו", "mx-merida-museo-conmemorativo-inmigracion-coreana-4725139124": "מוזיאון ההגירה הקוריאנית ליוקטן הוא מוזיאון במרידה שבמדינת יוקטן, מקסיקו. הוא הוקם ב-26 בפברואר 2005 או ב-15 במאי 2007, ומתמקד בהיסטוריה ובתרבות של הקוריאנים במקסיקו, ובמיוחד במרידה.", "mx-mexico-city-catedral-metropolitana-de-la-ciudad-de-m-862852010": "קתדרלת המטרופולין של עליית מרים הבתולה הקדושה השמימה, המכונה בדרך כלל קתדרלת המטרופולין של מקסיקו סיטי, היא כנסיית הקתדרלה של הארכידיוקסיה הקתולית של מקסיקו.", "mx-mexico-city-museo-frida-kahlo-176482295": "מוזיאון פרידה קאלו, הידוע גם כ\"הבית הכחול\" בזכות קירותיו הכחולים-קובלט, הוא בית-מוזיאון היסטורי ומוזיאון לאמנות המוקדש לחייה וליצירתה של האמנית המקסיקנית פרידה קאלו. הוא שוכן בשכונת קולוניה דל כרמן ברובע קויואקן במקסיקו סיטי.", "mx-mexico-city-plaza-de-la-constitucion-19430125": "סוקאלו הוא השם המקובל של הכיכר הראשית במרכז מקסיקו סיטי. לפני הכיבוש הספרדי היה זה המרכז הטקסי הראשי של העיר האצטקית טנוצ'טיטלן.", "mx-mexico-city-basilica-de-santa-maria-de-guadalupe-120733641": "הבזיליקה של גבירתנו מגוואדלופה, ששמה הרשמי הבזיליקה הנודעת והלאומית של סנטה מריה דה גוואדלופה, היא בזיליקה של הכנסייה הקתולית המוקדשת למרים הבתולה בדמותה כגבירתנו מגוואדלופה, והיא שוכנת למרגלות גבעת טפייאק.", "mx-mexico-city-museo-nacional-de-historia-castillo-de-c-17314437": "טירת צ'פולטפק שוכנת על ראש גבעת צ'פולטפק בפארק צ'פולטפק שבמקסיקו סיטי. השם צ'פולטפק בא מהמילה בנאוואטל צ'פולטפק, שפירושה \"על גבעת החגב\".", "mx-mexico-city-torre-latinoamericana-6071992": "טורה לטינואמריקנה הוא גורד שחקים במרכז מקסיקו סיטי. מיקומו המרכזי, גובהו ותולדותיו הופכים אותו לאחד מציוני הדרך החשובים בעיר.", "mx-mexico-city-monumento-a-la-revolucion-158032450": "אנדרטת המהפכה היא קשת זיכרון המנציחה את המהפכה המקסיקנית. היא שוכנת בכיכר הרפובליקה, סמוך למפגש העורקים הראשיים פסאו דה לה רפורמה ושדרת לוס אינסורחנטס במרכז מקסיקו סיטי.", "mx-mexico-city-museo-nacional-de-arte-14592229": "המוזיאון הלאומי לאמנות הוא מוזיאון האמנות הלאומי של מקסיקו, השוכן במרכז ההיסטורי של מקסיקו סיטי. המוזיאון שוכן במבנה ניאו-קלאסי.", "mx-mexico-city-alameda-central-4758957": "אלמדה סנטרל הוא פארק עירוני ציבורי במרכז מקסיקו סיטי. הוא הוקם ב-1592, והוא הפארק הציבורי העתיק ביותר ביבשת אמריקה.", "mx-mexico-city-antigua-academia-de-san-carlos-1421957132": "האקדמיה של סן קרלוס, שנודעה בעבר גם כבית הספר הלאומי לאמנויות יפות, היא אקדמיה לאמנות במקסיקו סיטי, שמילאה תפקיד חשוב בהיסטוריה של התפתחות האמנות והאדריכלות המקסיקנית.", "mx-mexico-city-palacio-de-iturbide-158032454": "ארמון איטורבידה הוא מעון מפואר וגדול במרכז ההיסטורי של מקסיקו סיטי, ברחוב מדרו 17. הוא נבנה בידי הרוזן מסן מטאו ולפראיסו כמתנת חתונה לבתו.", "mx-mexico-city-palacio-postal-157051114": "ארמון הדואר של מקסיקו, הידוע גם כ\"קוראו מאיור\", שוכן במרכז ההיסטורי של מקסיקו סיטי, על ציר אחה סנטרל סמוך לפלאסיו דה בז'ס ארטס. הוא נבנה ב-1907, כשהדואר הפך לגוף ממשלתי נפרד.", "mx-mexico-city-museo-nacional-de-san-carlos-12682671498": "המוזיאון הלאומי סן קרלוס הוא מוזיאון אמנות לאומי מקסיקני המוקדש לאמנות אירופית, ברובע קואאוטמוק במקסיקו סיטי. המוזיאון שוכן בארמון הרוזן מבואנוויסטה, מבנה ניאו-קלאסי ברחוב פואנטה דה אלוורדו.", "mx-mexico-city-museo-de-arte-moderno-370526901": "המוזיאון לאמנות מודרנית הוא מוזיאון המוקדש לאמנות מקסיקנית מודרנית, בפארק צ'פולטפק במקסיקו סיטי. המוזיאון הוא חלק מהמכון הלאומי לאמנויות יפות ולספרות, ומציג תערוכות של אמנים עכשוויים מקסיקנים ובינלאומיים.", "mx-mexico-city-museo-franz-mayer-8546501": "מוזיאון פרנץ מאייר במקסיקו סיטי נפתח ב-1986 כדי לשכן, להציג ולשמר את האוסף הגדול ביותר באמריקה הלטינית של אמנויות דקורטיביות.", "mx-mexico-city-plaza-garibaldi-15985584": "כיכר גריבלדי שוכנת במרכז ההיסטורי של מקסיקו סיטי, על ציר אחה סנטרל, בין הרחובות ההיסטוריים רפובליקה דה הונדורס ורפובליקה דה פרו, כמה רחובות צפונית לפלאסיו דה בז'ס ארטס.", "mx-playa-del-carmen-xcaret-13652365": "פארק שקרט הוא פארק נושא, אתר נופש ומיזם המגדיר את עצמו כאקו-תיירותי, בבעלות ובהפעלה פרטית, השוכן בריביירה מאיה, חלק מחוף הים הקריבי של מדינת קינטנה רו במקסיקו.", "mx-san-miguel-de-allende-parroquia-san-miguel-arcangel-1171309278": "כנסיית קהילה בסן מיגל דה איינדה"}}
