# Copy to .env.local. Every variable is OPTIONAL: without any of them the app
# runs in demo mode (local data, free public APIs, plain search links).

# --- Database (milestone 2) ---
# Development: SQLite file. Production (Vercel): a PostgreSQL URL from Neon / Supabase.
DATABASE_URL="file:./dev.db"

# --- Force demo banner on/off (default: on when no keyed provider is set) ---
# NEXT_PUBLIC_DEMO_MODE=true

# --- Optional keyed providers (milestone 6) ---
# GOOGLE_PLACES_API_KEY=
# AI assistant tab (milestone 8c). Without a key the tab explains that one is needed.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Free providers (milestone 6): no keys needed. Override the endpoints if you self-host. ---
# OSRM_BASE_URL=https://routing.openstreetmap.de/routed-{profile}
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Force every mock provider (no network at all; used by tests / offline demos):
# TRIPLAN_OFFLINE=true

# --- Affiliate IDs (milestones 6 + 9). Without them links are plain deep links (city + dates), no commission.
# Sign-up links and what each value looks like: docs/affiliates.md
# AFFILIATE_BOOKING_AID=
# AFFILIATE_GETYOURGUIDE_PARTNER_ID=
# AFFILIATE_VIATOR_PID=
# AFFILIATE_TIQETS_PARTNER=
# AFFILIATE_KLOOK_AID=
# AFFILIATE_KIWI_AFFILID=
# Any other partner: the raw tracking query from its link generator (the part after "?"), e.g. "cid=1234567"
# AFFILIATE_QUERY_AGODA=
# AFFILIATE_QUERY_HOTELSCOM=
# AFFILIATE_QUERY_HOSTELWORLD=
# AFFILIATE_QUERY_SKYSCANNER=
# AFFILIATE_QUERY_RENTALCARS=
# AFFILIATE_QUERY_DISCOVERCARS=

# --- Auth (milestone 8b). Sign-in works with none of these: the magic link is shown on screen (demo mode). ---
# Required in production (any long random string, e.g. `openssl rand -base64 32`):
# AUTH_SECRET=
# Email magic links through Resend (https://resend.com, free tier). Without it: demo link on screen.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="Triplan <login@yourdomain.com>"
# Google sign-in (optional): OAuth client from https://console.cloud.google.com, redirect URI /api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Allow the on-screen demo link in production too. Never on a public site: anyone can sign in as anyone.
# AUTH_DEMO_LOGIN=true
